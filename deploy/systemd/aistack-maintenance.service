# AIStack — maintenance page, served while Docker is stopped
#
# Its own nginx (deploy/maintenance/nginx.conf), outside Docker, answering
# 503 and the maintenance page on port 80. Started and stopped on demand,
# by scripts/maintenance_page.sh around the weekly full backup (ReaR),
# which stops Docker; there is deliberately no [Install] section.
#
# Install (as root, on the host), once:
#
#   scripts/maintenance_page.sh install            # simulation: --dry-run
#
# What it did: journalctl -u aistack-maintenance -n 40

[Unit]
Description=AIStack maintenance page (nginx, outside Docker)
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/aistack-maintenance/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/aistack-maintenance/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -c /etc/aistack-maintenance/nginx.conf -s reload
Restart=on-failure
RestartSec=3
