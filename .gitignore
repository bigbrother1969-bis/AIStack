/reports/generated
/reports/generated.avant-deplacement/
/data_location.yml

# The smartphone selection and its generation report, written on the host.
examples/selections/music-android-selection-real.yml
examples/selections/*-last-generation.yml

# Local backups and patches in transit.
*.bak-*
*.patch
patches-*.tar.gz

