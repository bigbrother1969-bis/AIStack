# AIStack — docker-diff monitor
#
# 1.5's second collector (`claude/ROADMAP-1.2-TO-2.0-2026-09-27.md`
# § 1.5): polls every running container's own `docker diff` each
# cycle (mount paths filtered out at collection time — cadrage
# 2026-09-28) and records a subject's own snapshot to Observation
# History only when it changed, the raw stream `aistack.timemachine
# .projection.project_docker_diff` turns into graph facts on the next
# `timemachine_rebuild`.
#
# Runs on the host, not in a container — the same reasoning
# `aistack-docker-events-monitor.service`'s own comment already gives
# for its own Docker-socket dependency, applied here to a second
# process with the same requirement.
#
# Install (as root, on GIGABYTE):
#
#   cp deploy/systemd/aistack-docker-diff-monitor.service \
#       /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now aistack-docker-diff-monitor
#
# Before enabling it as a service, run it once by hand to check it
# against the real Docker daemon without risking an unattended loop:
#
#   ./run_docker_diff_monitor.sh --once --dry-run
#
# Watch it with:
#
#   journalctl -u aistack-docker-diff-monitor -f

[Unit]
Description=AIStack docker-diff monitor (container filesystem drift, 1.5)
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/aistack/AIStack
ExecStart=/srv/aistack/AIStack/run_docker_diff_monitor.sh
Restart=on-failure
RestartSec=5

# SIGTERM is what lets the monitor log a clean "stopping" line and
# return promptly, the same `KillSignal`/`TimeoutStopSec` pair
# `aistack-docker-events-monitor.service` already declares for its
# own clean-shutdown handling.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
