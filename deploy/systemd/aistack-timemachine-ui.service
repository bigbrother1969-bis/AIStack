# AIStack — Time Machine UI
#
# A read-only browser over the Time Machine's PROV-O graph (`ADR-0011`) —
# streams -> instants -> facts, plus "Référencé par" for anything an
# entity is attributed to or used by. Built as its own small app, the
# same pattern aistack-priority-ui.service, aistack-selection-ui.service,
# aistack-network-discovery-ui.service and
# aistack-troubleshooting-assistant-ui.service already are.
#
# **LAN-only, on purpose — but the bind address is the same as the
# other four UIs (0.0.0.0), reachable from anywhere on the owner's
# LAN.** What keeps this LAN-only is that it has NO Proxy Host entry
# anywhere — see run_timemachine_ui.sh's own comment. Do not add a
# reverse-proxy entry for this unit.
#
# Runs on the host, not in a container: it opens the graph on disk
# read-only (`OxigraphGraphStore.read_only`), writing nothing. The
# graph itself is written separately, on demand, by
# `python -m aistack.cli.timemachine_rebuild` — either through
# `docker compose run --rm aistack-core` when that path works, or
# directly against the governed `.venv` when it does not (`pyoxigraph`
# has been a core dependency since patch 0048, so no container is
# actually required to run this command).
#
# Install (as root, on GIGABYTE):
#
#   cp deploy/systemd/aistack-timemachine-ui.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now aistack-timemachine-ui
#
# Before enabling it as a service, confirm nothing else already
# holds port 8186 — the Troubleshooting Assistant's own unit
# documents hitting exactly this once for its own port:
#
#   ss -ltnp | grep :8186
#
# Watch it with:
#
#   journalctl -u aistack-timemachine-ui -f

[Unit]
Description=AIStack Time Machine UI (read-only PROV-O graph browser, LAN-only)
After=network.target

[Service]
Type=simple
# Run as the repo owner, not as root (2026-10-02, after the four 1.5
# Docker monitors moved the same way). Nothing here needs root: the
# Docker socket comes with the `docker` group big-brother is in, every
# port is above 1024, and every file read or written is under the
# repository, which big-brother owns.
User=big-brother
Group=big-brother
WorkingDirectory=/srv/aistack/AIStack
ExecStart=/srv/aistack/AIStack/run_timemachine_ui.sh
Restart=on-failure
RestartSec=5

# uvicorn already shuts down cleanly on SIGTERM (drains in-flight
# requests, then exits) — same as the other four UIs' own units. This
# screen never holds anything open across a stop: each request opens
# its own read-only handle and closes it, nothing here writes.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
