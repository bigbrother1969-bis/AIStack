# AIStack — the generalized sync's executor (ADR-0022 § 6, 2.0)
#
# Brings each (content, destination) folder to the selection recorded
# on the Selection screen: hard links on the content's own disk, which
# Syncthing carries to the device. A pair with no recorded selection is
# never touched. Runs as the account that owns the content disks.
#
# Install (as root, on GIGABYTE), once:
#
#   cp deploy/systemd/aistack-sync.service deploy/systemd/aistack-sync.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now aistack-sync.timer
#
# What it did: journalctl -u aistack-sync -n 50 ; ./run_sync.sh --list

[Unit]
Description=AIStack sync executor (selections to devices)
After=local-fs.target

[Service]
Type=oneshot
User=big-brother
Group=big-brother
WorkingDirectory=/srv/aistack/AIStack
ExecStart=/srv/aistack/AIStack/run_sync.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
