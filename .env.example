# AIStack — docker compose settings (ADR-0017). Copy to `.env`, then edit.

# The published version to run — 1.8.0 or later: earlier images run
# only the knowledge-integrity validator. `dev` with `docker compose
# build` runs an image built from this checkout, never pushed.
AISTACK_VERSION=2.0.0-rc1

# The account the services run as (`id -u`, `id -g`): it owns ./config
# and ./data.
AISTACK_UID=1000
AISTACK_GID=1000

# The group of the Docker socket (`stat -c %g /var/run/docker.sock`).
DOCKER_GID=999

# Where AIStack keeps its data on this host: ./data unless you moved it
# (Settings → Disks and mounts shows the commands, 1.8).
# AISTACK_DATA_DIR=./data
