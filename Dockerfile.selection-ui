# **Cannot be built since 2026-10-03.** `selection_ui/` moved into
# AIStack's single web application (`ADR-0012`, `aistack.web.selection`)
# and the `COPY selection_ui` below names a directory that no longer
# exists. Kept until 1.7's first tranche closes `GOV-0002/OS-084`:
# `aistack.cli.runtime_diagnose` and three tests still read this file's
# `FROM` and `CMD` as the record of the image that ran, and retiring
# them is one change with retiring the image itself.
FROM python:3.13-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY selection_ui ./selection_ui
COPY examples ./examples

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir . \
 && pip install --no-cache-dir \
      fastapi \
      uvicorn \
      jinja2 \
      python-multipart

ENV PYTHONPATH=/app/src

EXPOSE 8181

CMD ["python3","-m","uvicorn","selection_ui.app:app","--host","0.0.0.0","--port","8181"]
